# Copy to .env (gitignored) and adjust. Read by docker-compose.yml only; the values reach the
# services as environment variables and override their appsettings.json.
#
# Every line repeats the default that docker-compose.yml already applies, so this file doubles
# as a reference. Delete a line to inherit the default instead of pinning it.

# --- compose ---------------------------------------------------------------------------------

# Profiles to activate:
# - empty starts db + api + indexer-tezosx;
# - "metadata" adds the metadata service;
# - "full" adds both the metadata and the L1 indexer.
COMPOSE_PROFILES=

# --- db --------------------------------------------------------------------------------------

# Name of the database to create.
POSTGRES_DB=xtzkt_db

# Cluster superuser to create.
POSTGRES_USER=xtzkt

# Superuser password.
POSTGRES_PASSWORD=123

# Host port the database is published on.
POSTGRES_PORT=5432

# Host interface it is published on; loopback keeps that off the network.
POSTGRES_BIND=127.0.0.1

# DB queries timeout in seconds.
COMMAND_TIMEOUT=600

# --- api -------------------------------------------------------------------------------------

# Host port the API will be available at.
API_PORT=5000

# --- indexer-l1 ------------------------------------------------------------------------------

# Tezos L1 node RPC to fetch data from.
L1_TEZOS_NODE=https://rpc.tzkt.io/shadownet

# Host port the L1 indexer will be available at.
L1_PORT=5001

# --- indexer-tezosx --------------------------------------------------------------------------

# Tezos X Michelson RPC to fetch Michelson runtime data from.
TEZOSX_TEZOS_NODE=https://michelson.previewnet.tezosx.nomadic-labs.com

# Tezos X EVM RPC to fetch EVM runtime data from.
TEZOSX_EVM_NODE=https://evm.previewnet.tezosx.nomadic-labs.com

# Host port the Tezos X indexer will be available at.
TEZOSX_PORT=5002

# --- metadata (profiles: metadata, full) -----------------------------------------------------

# EVM RPC used to read ERC-20 metadata straight from contracts.
METADATA_EVM_NODE=https://evm.previewnet.tezosx.nomadic-labs.com

# IPFS gateway used to fetch off-chain token metadata.
METADATA_IPFS_GATEWAY=https://ipfs.io/ipfs

# DipDup GraphQL endpoint for chain 0 (L1).
METADATA_L1_DIPDUP_URL=https://metadata.dipdup.net/v1/graphql

# DipDup index name to track for chain 0.
METADATA_L1_DIPDUP_INDEX=metadata_shadownet

# Network name DipDup rows are filtered by for chain 0; must match L1_TEZOS_NODE's network.
METADATA_L1_DIPDUP_NETWORK=shadownet

# DipDup GraphQL endpoint for chain 1 (Tezos X).
METADATA_TEZOSX_DIPDUP_URL=https://metadata.dipdup.net/v1/graphql

# DipDup index name to track for chain 1.
METADATA_TEZOSX_DIPDUP_INDEX=metadata_tezosx

# Network name DipDup rows are filtered by for chain 1; must match the Tezos X network indexed.
METADATA_TEZOSX_DIPDUP_NETWORK=tezosx

# Host port the metadata service will be available at.
METADATA_PORT=5003
